{
  "name": "hly-cli",
  "version": "0.1.0",
  "description": "hly · 汇联易（Huilianyi）开放 API 的命令行封装，给 AI Agent 用：报销、申请、审批、花费查询。每个人用自己的凭证。",
  "type": "module",
  "bin": { "hly": "./bin/hly.js" },
  "files": ["bin", "dist", "docs", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "node --no-warnings --import tsx src/cli.ts",
    "mock": "node --no-warnings --import tsx test/mock-server.ts",
    "test": "tsc -p tsconfig.json && node --no-warnings --import tsx test/e2e.ts"
  },
  "engines": { "node": ">=20" },
  "license": "MIT",
  "dependencies": { "commander": "^15.0.0" },
  "devDependencies": { "@hono/node-server": "^2.1.6", "@types/node": "^26.6.6", "hono": "^4.13.16", "tsx": "^4.23.15", "typescript": "^7.0.2" }
}
